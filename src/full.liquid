<div class="layout layout--top">
    <div class="flex flex--col stretch-x">
        {% if nrcc_text != "" %}
        <div class="flex flex--row flex--left">
            <div class="image image-stroke">{{ alert_logo }}</div>
            <div class="description stretch-x" data-clamp="3">{{ nrcc_text }}</div>
        </div>
        {% endif %}
        <table class="table" data-table-limit="true" table-overflow-counter="false">
            <thead>
                <tr>
                    <th><span class="title">Departure</span></th>
                    <th><span class="title">Coaches</span></th>
                    <th><span class="title">Arrival</span></th>
                </tr>
            </thead>
            <tbody>
                {% if result_count > 0 %}
                {% for service in trainServices %}
                {% assign destination = service.subsequentCallingPoints.first.callingPoint | where: "crs", filtercrs | first %}
                {% assign row_cancelled = false %}
                {% if service.etd == "Cancelled" or destination.isCancelled %}{% assign row_cancelled = true %}{% endif %}
                {% assign status_text = "" %}
                {% if row_cancelled %}{% assign status_text = "Cancelled" %}
                {% elsif service.etd == "Delayed" %}{% assign status_text = "Delayed" %}
                {% elsif service.etd != "On time" %}{% capture status_text %}Exp {{ service.etd }}{% endcapture %}{% endif %}
                <tr>
                    <td>
                        <span class="label">
                            {% if status_text != "" %}<s>{{ service.std }}</s>{% else %}{{ service.std }}{% endif %}{% if status_text != "" %}&nbsp;&nbsp;&nbsp;{{ status_text }}{% endif %}
                        </span>
                        {% if fast_train_threshold > 0 %}
                        {% assign departure_time = "now" | date: "%d %B %Y " | append: service.std | date: "%s" | divided_by: 60 %}
                        {% assign arrival_time = "now" | date: "%d %B %Y " | append: destination.st | date: "%s" | divided_by: 60 %}
                        {% assign duration = arrival_time | minus: departure_time %}
                        {% if duration < fast_train_threshold %}
                        <span class="image image-stroke">{{ fast_train_logo }}</span>
                        {% endif %}
                        {% endif %}
                    </td>
                    <td>
                        <span class="label">{% if service.length > 0 %}{% if row_cancelled %}<s>{{ service.length }}</s>{% else %}{{ service.length }}{% endif %}{% endif %}</span>
                    </td>
                    <td>
                        <span class="label">
                            {% if row_cancelled %}<s>{{ destination.st }}</s>
                            {% elsif destination.et != "On time" and destination.et != "Delayed" %}
                            Exp {{ destination.et }}
                            {% else %}
                            {{ destination.st }}
                            {% endif %}
                        </span>
                    </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                    <td colspan="3">
                        <span class="label">No services scheduled</span>
                    </td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
<div class="title_bar">
    <span class="title">From {{ locationName }} to {{ filterLocationName }}</span>
    <span class="instance">{{  generatedAt | date: "%H:%M on %d/%m/%y" }}</span>
</div>
